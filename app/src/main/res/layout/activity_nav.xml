<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FC"
    tools:context=".NavActivity">

    <!-- TOP NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_top_navigation"
        android:elevation="6dp"
        app:itemIconSize="26dp"
        app:itemIconTint="#6C5CE7"
        app:labelVisibilityMode="unlabeled"
        app:itemHorizontalTranslationEnabled="false"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- PROFILE IMAGE -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profile_imageNav"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/base_img"
        app:civ_border_color="#7865E8"
        app:civ_border_width="2dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- PAGE TITLE -->
    <TextView
        android:id="@+id/titleNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        android:text="FindProfessionals"
        android:textColor="#211B3A"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/profile_imageNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_imageNav"
        app:layout_constraintBottom_toBottomOf="@id/profile_imageNav"/>

    <!-- SEARCH CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="#E9E7F2"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/profile_imageNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Search for a professional..."
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#211B3A"
            android:textColorHint="#9995AE"
            android:textSize="15sp"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- SCROLLABLE CATEGORIES -->
    <ScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- SECTION TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore categories"
                android:textColor="#211B3A"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                android:text="Find the right professional for your needs"
                android:textColor="#8886A3"
                android:textSize="14sp"/>

            <!-- CATEGORY GRID -->
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2">

                <!-- HOME SERVICES -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd1"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#EEE9FF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img1"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Home services"
                            android:textColor="#34275F"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Repairs, cleaning and more"
                            android:textColor="#77718F"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- TECHNOLOGY -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd2"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#E4F5F1"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img2"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Technology"
                            android:textColor="#285D55"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="IT, electronics and software"
                            android:textColor="#718E88"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- EDUCATION -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd3"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFF0DC"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img3"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Education"
                            android:textColor="#78512B"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tutors, courses and coaching"
                            android:textColor="#987A59"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CREATIVE -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd4"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FCE8F0"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img4"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Creative"
                            android:textColor="#82435F"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Design, photography and video"
                            android:textColor="#A17C90"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SHOPPING -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd5"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#E8EDFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img5"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Shopping"
                            android:textColor="#354A86"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Products, services and delivery"
                            android:textColor="#7785AE"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BUYING / SELLING -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/crd6"
                    android:layout_width="0dp"
                    android:layout_height="165dp"
                    android:layout_margin="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FCECDD"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:layout_columnWeight="1">

                    <LinearLayout
                        android:id="@+id/l6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/img6"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/base_img"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/txt6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Buying / Selling"
                            android:textColor="#78512B"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Real estate, vehicles and goods"
                            android:textColor="#987A59"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.gridlayout.widget.GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
