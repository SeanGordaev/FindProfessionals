<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    tools:context=".RegActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="JOIN US"
                android:textColor="#536DFE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Create account"
                android:textColor="#17213B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Let's get to know you who you are and found what you need!"
                android:textColor="#69758C"
                android:textSize="13sp"
                android:gravity="center" />

            <!-- USER INTERFACE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/editFirstName"
                    android:text="First name"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="personGivenName"
                    android:backgroundTint="#CBD3E5"
                    android:hint="Enter your first name"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editLastName"
                    android:text="Last name"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editLastName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="personFamilyName"
                    android:backgroundTint="#CBD3E5"
                    android:hint="Enter your last name"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editEmail"
                    android:text="Email address"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:backgroundTint="#CBD3E5"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editAddress"
                    android:text="Home address"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="postalAddress"
                    android:backgroundTint="#CBD3E5"
                    android:hint="Street, house number, city"
                    android:inputType="textPostalAddress|textMultiLine"
                    android:gravity="top|start"
                    android:maxLines="3"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editBirthday"
                    android:text="Date of birth"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#CBD3E5"
                    android:hint="DD/MM/YYYY"
                    android:inputType="date"
                    android:imeOptions="actionNext"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editPhone"
                    android:text="Phone number"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="phone"
                    android:backgroundTint="#CBD3E5"
                    android:hint="Enter your phone number"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/editPassword"
                    android:text="Enter password"
                    android:textColor="#17213B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    />

                <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="password"
                    android:backgroundTint="#CBD3E5"
                    android:hint="Enter password here"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:textColor="#17213B"
                    android:textColorHint="#8792A8"
                    android:textSize="16sp" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#E8ECF4" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What brings you here?"
                    android:textColor="#17213B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:buttonTint="#536DFE"
                        android:paddingEnd="8dp"
                        android:text="Looking for a professional"
                        android:textColor="#17213B"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioProfessional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="4dp"
                        android:buttonTint="#536DFE"
                        android:paddingEnd="8dp"
                        android:text="I'm a professional"
                        android:textColor="#17213B"
                        android:textSize="14sp" />

                </RadioGroup>

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#536DFE"
                    android:text="Create account"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Already have an account?"
                android:textColor="#69758C"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBackToLogin"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Sign in"
                android:textAllCaps="false"
                android:textColor="#536DFE"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>