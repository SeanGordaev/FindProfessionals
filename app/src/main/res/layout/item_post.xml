<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#ECEAF5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Client profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/postAuthorImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/postAuthorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="David Cohen"
                android:textColor="#211B3A"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Client phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@android:drawable/ic_menu_call"
                android:contentDescription="Phone"
                app:tint="#536DFE"/>

            <TextView
                android:id="@+id/postAuthorPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:text="+972 50-123-4567"
                android:textColor="#8792A8"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Post title -->
        <TextView
            android:id="@+id/postTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Looking for a plumber"
            android:textColor="#211B3A"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- Category -->
        <TextView
            android:id="@+id/postCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Plumbing"
            android:textColor="#536DFE"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- Full post -->
        <TextView
            android:id="@+id/postContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="I need someone to repair a leaking pipe in my kitchen. Please contact me if you are available."
            android:textColor="#51566B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:breakStrategy="high_quality"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
